# Crypto AI Trading Intelligence - Environment Configuration

# Application
PROJECT_NAME="Crypto AI Trading Intelligence"
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./crypto_trading.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/crypto_trading
REDIS_URL=redis://localhost:6379/0

# Exchange Providers
DEFAULT_SYMBOL=BTCUSDT
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws

# Optional Exchange Keys (Not required for public market data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI Provider Key (For Phase 12 AI explanation layer)
AI_API_KEY=

# Safety & Trading Flags (Live trading strictly disabled by default)
ENABLE_PAPER_TRADING=false
ENABLE_LIVE_TRADING=false
